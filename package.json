{
  "name": "cornerstone-v2",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "sh -c 'set -a && . .env.local && set +a && next dev --port 3001'",
    "build": "next build",
    "start": "next start",
    "lint": "node scripts/link-eslint-ts6.js && eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check:rebrand": "node scripts/check-rebrand.js",
    "check:ai-gateway": "node scripts/check-ai-gateway.js",
    "check:seed-casts": "node scripts/check-seed-casts.js",
    "check:json-body": "node scripts/check-json-body.js",
    "check:demo-seed": "node scripts/check-demo-seed.js",
    "check:seed-refs": "node scripts/check-seed-refs.js",
    "check:dal-persistence": "node scripts/check-dal-persistence.js",
    "check:api-contracts": "node scripts/check-api-contracts.js",
    "check:modal-viewport": "node scripts/check-modal-viewport.js",
    "check:hook-refs": "node scripts/check-hook-refs.js",
    "verify:batch": "node scripts/check-hook-refs.js && node scripts/check-api-contracts.js && npx tsc --noEmit && next build",
    "verify:live": "node scripts/check-live-drift.js",
    "postinstall": "node scripts/link-eslint-ts6.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.250",
    "@anthropic-ai/sdk": "^0.122.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.3",
    "@tanstack/react-query": "^5.102.8",
    "ai": "^7.0.83",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "docx": "^9.7.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.35.0",
    "next": "^16.3.3",
    "pdfjs-dist": "^6.2.108",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "playwright": "^1.59.1",
    "qrcode": "^1.5.4",
    "shadcn": "^4.19.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7",
    "typescript6": "npm:typescript@^6.0.3",
    "vitest": "^4.1.11"
  }
}
