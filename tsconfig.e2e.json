{
  // CI "Type check" config — validates the Playwright e2e suite.
  //
  // tsconfig.json EXCLUDES e2e/ and playwright.config.ts, so until TS7 made a
  // full check cheap (~25s vs 3-4 min) these files were type-checked by nothing
  // at all: Playwright transpiles specs at run time and the e2e suite is not a
  // CI job, so a rotted selector helper or a renamed export sat undetected.
  //
  // `types: ["node"]` is REQUIRED and must NOT be replaced with `next-env.d.ts`
  // in `include`. next-env.d.ts is GENERATED by next dev/build and is gitignored,
  // so it exists locally and NEVER on a fresh CI checkout — relying on it passes
  // on a dev machine and fails in CI with TS2591 on every `process.env`. The app
  // configs get node's globals for free because app code imports node builtins;
  // these six spec files only import @playwright/test, so they need it declared.
  "extends": "./tsconfig.json",
  "compilerOptions": { "types": ["node"] },
  "include": ["e2e/**/*.ts", "playwright.config.ts"],
  "exclude": ["node_modules"]
}
