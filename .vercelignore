# Test files — not needed for deployment
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
**/__tests__/**

# E2E tests
e2e/

# Documentation
docs/
*.md
!README.md

# Scripts — excluded wholesale, EXCEPT anything package.json runs at install
# time. postinstall executes during Vercel's `npm install`, so an ignored
# script file fails the whole deployment in ~26 seconds with MODULE_NOT_FOUND
# (learned live: #899 broke every production deploy until this allowlist).
# gitignore semantics: a file cannot be re-included when its PARENT DIRECTORY
# is excluded, so `scripts/` + `!scripts/x` silently ignores the negation.
# Excluding the directory's CONTENTS (`scripts/*`) leaves the directory itself
# traversable, which is what makes the negation effective.
scripts/*
!scripts/link-eslint-ts6.js

# Local config
playwright.config.ts
vitest.config.ts

# Misc
index.mjs
.agents/
